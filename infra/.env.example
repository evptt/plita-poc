# Скопируй этот файл в .env и замени все пароли.
# Сгенерировать пароль на сервере:  openssl rand -hex 24
# .env НИКОМУ не отправлять и не коммитить в git.

# Адрес, по которому мобилка ходит в API.
# Нет своего домена — подставь IP сервера через sslip.io, точки заменить на дефисы:
#   IP 185.1.2.3  ->  DOMAIN=185-1-2-3.sslip.io
DOMAIN=185-1-2-3.sslip.io

# Запускать ли эмулятор датчика/реле вместе со всем остальным (пусто — не запускать)
COMPOSE_PROFILES=emulator

POSTGRES_DB=plita
POSTGRES_USER=plita
POSTGRES_PASSWORD=change_me

# Пароль сервиса бэкенда в MQTT (логин: backend)
MQTT_BACKEND_PASSWORD=change_me
# Общий пароль для датчиков и реле в MQTT (логин: device) — его прошьют в железо
MQTT_DEVICE_PASSWORD=change_me

JWT_SECRET=change_me
# Выдаётся в Google Cloud Console (Web Client ID; можно несколько через запятую), заполнит тот, кто делает авторизацию
GOOGLE_CLIENT_ID=
# Вход без Google через POST /api/v1/auth/dev — только на время разработки, на боевом сервере false
DEV_AUTH_ENABLED=false

# ---------- Силовой автомат Tongou (заводская прошивка Tuya) ----------
# Облачный проект на platform.tuya.com: Cloud -> Development -> проект -> Overview -> Access ID / Access Secret.
# Пусто — бэкенд работает только с эмулятором реле через MQTT.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Дата-центр проекта: Central Europe https://openapi.tuyaeu.com, Western Europe https://openapi-weaz.tuyaeu.com,
# America https://openapi.tuyaus.com, China https://openapi.tuyacn.com, India https://openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com
# Как часто опрашивать автомат, секунд. Каждый опрос — вызов API из квоты IoT Core:
# 120 с — около 21 600 вызовов в месяц на один автомат.
TUYA_POLL_INTERVAL_S=120
# Коды DP автомата и множители до ампер/вольт. Посмотреть: лог бэкенда при первом опросе
# («Tuya <id>: online=..., статус {...}») или Tuya IoT Platform -> Devices -> Device Debugging.
# Если тока/напряжения нет, но есть phase_a, бэкенд разберёт его сам.
TUYA_SWITCH_CODE=switch
TUYA_CURRENT_CODE=cur_current
TUYA_CURRENT_SCALE=0.001
TUYA_VOLTAGE_CODE=cur_voltage
TUYA_VOLTAGE_SCALE=0.1

# ---------- Push «красного экрана» (Firebase Cloud Messaging) ----------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Скачанный JSON одной строкой в base64:  base64 -w0 firebase-key.json
FIREBASE_SERVICE_ACCOUNT=
# Канал уведомлений Android-приложения для тревог (если мобильщики его создают), иначе пусто
FIREBASE_ANDROID_CHANNEL_ID=
